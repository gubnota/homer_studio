{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homer Studio",
  "version": "0.2.8",
  "identifier": "com.gubnota.homerstudio",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; media-src 'self' audio: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost audio: http://audio.localhost"
    },
    "windows": [
      {
        "title": "Homer Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700,
        "backgroundColor": "#f7f7f5",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../workers/start_local.py": "workers/start_local.py",
      "../workers/worker_protocol.py": "workers/worker_protocol.py",
      "../workers/chatterbox/server.py": "workers/chatterbox/server.py",
      "../workers/chatterbox/original.py": "workers/chatterbox/original.py",
      "../workers/chatterbox/requirements.txt": "workers/chatterbox/requirements.txt",
      "../workers/audio/processor.py": "workers/audio/processor.py",
      "../workers/audio/inference_driver.py": "workers/audio/inference_driver.py",
      "../workers/audio/seed_vc.txt": "workers/audio/seed_vc.txt",
      "../workers/audio/rvc.txt": "workers/audio/rvc.txt",
      "../workers/audio/deepfilternet.txt": "workers/audio/deepfilternet.txt",
      "../workers/audio/resemble_enhance.txt": "workers/audio/resemble_enhance.txt",
      "../resources/sfx/sitcom_laugh01.m4a": "sfx/sitcom_laugh01.m4a",
      "../resources/sfx/intro.m4a": "sfx/intro.m4a",
      "../resources/sfx/outro.m4a": "sfx/outro.m4a",
      "../resources/sfx/rewind.webm": "sfx/rewind.webm",
      "../resources/sfx/shoosh_large.webm": "sfx/shoosh_large.webm",
      "../resources/sfx/riser.webm": "sfx/riser.webm",
      "../resources/sfx/suspense.webm": "sfx/suspense.webm",
      "../resources/sfx/thud.webm": "sfx/thud.webm",
      "../resources/sfx/surprise_shocked.mp3": "sfx/surprise_shocked.mp3",
      "../resources/sfx/gong.mp3": "sfx/gong.mp3",
      "../resources/sfx/closing_door.mp3": "sfx/closing_door.mp3"
    },
    "category": "Productivity",
    "shortDescription": "Local-first audiobook production studio",
    "longDescription": "Create, edit, review, and export audiobook projects with local tools on Apple Silicon Macs.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "wavehs"
        ],
        "name": "Homer Studio Wave Project",
        "role": "Editor",
        "mimeType": "application/x-homer-wave"
      }
    ]
  }
}
