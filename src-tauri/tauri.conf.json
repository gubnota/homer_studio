{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homer Studio",
  "version": "0.2.0",
  "identifier": "com.gubnota.homerstudio",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; media-src 'self' audio: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "Homer Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700,
        "backgroundColor": "#f7f7f5",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Local-first audiobook production studio",
    "longDescription": "Create, edit, review, and export audiobook projects with local tools on Apple Silicon Macs.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
