{
  "name": "homer-studio",
  "version": "0.1.0",
  "description": "Local-first audiobook production studio for Apple Silicon Macs",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm test && npm run build:web",
    "build:web": "vite build",
    "pack:mac": "tauri build --bundles app",
    "package:mac": "tauri build --bundles app,dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "^5.8.3",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
